{
  "installCommand": "cd \"gtmwael-main 2\" && npm install",
  "buildCommand": "cd \"gtmwael-main 2\" && npm run build",
  "outputDirectory": "gtmwael-main 2/dist",
  "redirects": [
    {
      "source": "/(.+)/",
      "has": [
        {
          "type": "host",
          "value": "yoursaasgrowth.com"
        }
      ],
      "destination": "https://www.yoursaasgrowth.com/$1",
      "permanent": true
    },
    {
      "source": "/(.*)",
