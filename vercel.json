{
  "installCommand": "cd \"gtmwael-main 2\" && npm install",
  "buildCommand": "cd \"gtmwael-main 2\" && npm run build",
  "outputDirectory": "gtmwael-main 2/dist",
  "headers": [
    {
      "source": "/manymotions(.*)",
      "headers": [{ "key": "X-Robots-Tag", "value": "noindex, nofollow" }]
    }
  ],
  "redirects": [
    {
      "source": "/blog/saas-landing-page-google-meta-ads",
      "destination": "/google-ads-vs-meta-ads-saas",
      "permanent": true
    },
    {
      "source": "/cro-teardowns/lucidya-v2",
      "destination": "/cro-teardowns/lucidya",
      "permanent": true
    },
    {
      "source": "/(.+)/",
      "has": [
        {
          "type": "host",
          "value": "yoursaasgrowth.com"
        }
      ],
      "destination": "https://www.yoursaasgrowth.com/$1",
      "permanent": true
    },
    {
      "source": "/(.*)",
      "has": [
        {
          "type": "host",
          "value": "yoursaasgrowth.com"
        }
      ],
      "destination": "https://www.yoursaasgrowth.com/$1",
      "permanent": true
    },
    {
      "source": "/(.+)/",
      "has": [
        {
          "type": "host",
          "value": "www.yoursaasgrowth.com"
        }
      ],
      "destination": "https://www.yoursaasgrowth.com/$1",
      "permanent": true
    },
    {
      "source": "/blog/ai-news-2026-11-06",
      "destination": "/blog?type=news",
      "permanent": true
    }
  ]
}
